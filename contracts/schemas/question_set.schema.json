{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestionSet",
  "description": "All questions generated for one resume upload. Stored by Task 4 (backend).",
  "type": "object",
  "required": ["id", "resume_upload_id", "questions", "status", "created_at"],
  "properties": {
    "id": {
      "type": "string"
    },
    "resume_upload_id": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "question.schema.json" }
    },
    "status": {
      "type": "string",
      "enum": ["processing", "ready", "needs_input", "failed"],
      "description": "processing = generating; ready = done; needs_input = student must add details; failed = error."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}